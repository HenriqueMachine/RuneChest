// RuneChest · layout "runechest" — FoodBot with the Norse crew (2.9.0, user decisions 17–18/11)
// Tabs by layer: 1 NVIM · 2 PAINEL · 3 ODIN · 4 BACKEND · 5 APP · 6 ESPECIALISTAS · 7 TRIPULAÇÃO · 8 AMBIENTE (Alt 1..8)
// Odin starts with the layout. The other agent panes are suspended: ENTER starts the agent (on demand).
// When a session ends, the pane shows the command again and ENTER starts a new one (one session per ticket).
// The runes are the RuneChest Runes bind-runes (U+100000–U+10000D, assets/runes/codepoints.tsv; Ghostty maps them
// with font-codepoint-map). Names, colours and layers: vault 11-Agentes/Identidade.md.

layout {
    cwd "/Users/henriquepaixao/Foodbot"

    default_tab_template {
        // Native tab bar: zjstatus does not render on Zellij 0.44.3 (the same fix as work.kdl, 08e3020).
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        // The key hints at the bottom (Ctrl + g LOCK, p PANE, t TAB...), in the theme colours.
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // NVIM: the editor (70 %) and the GUIA (30 %, docs/guia-nvim.txt). Option+arrow goes between them; Option+g hides the guide.
    tab name="NVIM" {
        pane split_direction="vertical" {
            pane command="nvim" size="70%" focus=true
            pane name="GUIA" command="bash" size="30%" {
                args "/Users/henriquepaixao/Github/RuneChest/scripts/runechest-guide.sh"
            }
        }
    }

    // PAINEL (Huginn e Muninn): the crew and the diary on the left; machine, train, PRs and tokens on the right.
    tab name="PAINEL" {
        pane command="bash" borderless=true {
            args "/Users/henriquepaixao/Github/RuneChest/scripts/runechest-panel.sh"
        }
    }

    // Odin, the orchestrator: the only agent that starts with the layout (user decision 18/11).
    tab name="􀀀 ODIN" focus=true {
        pane name="􀀀 Odin · orquestrador" command="/Users/henriquepaixao/Foodbot/foodbot-ops/bin/agent" {
                args "odin"
            }
    }

    tab name="􀀁􀀃 BACKEND" {
        pane split_direction="vertical" {
            pane name="􀀁 Heimdall · integrador backend" command="/Users/henriquepaixao/Foodbot/foodbot-ops/bin/agent" start_suspended=true {
                args "heimdall"
            }
            pane name="􀀃 Eitri · executor backend" command="/Users/henriquepaixao/Foodbot/foodbot-ops/bin/agent" start_suspended=true {
                args "eitri"
            }
        }
    }

    tab name="􀀂􀀄 APP" {
        pane split_direction="vertical" {
            pane name="􀀂 Forseti · integrador app" command="/Users/henriquepaixao/Foodbot/foodbot-ops/bin/agent" start_suspended=true {
                args "forseti"
            }
            pane name="􀀄 Völundr · executor app" command="/Users/henriquepaixao/Foodbot/foodbot-ops/bin/agent" start_suspended=true {
                args "volundr"
            }
        }
    }

    // ESPECIALISTAS: Mímir │ Bifröst │ Frigg on top, Bragi │ Níðhöggr below (Frigg joined 18/11: product and design).
    tab name="􀀉􀀊􀀍􀀋􀀌 ESPECIALISTAS" {
        pane split_direction="horizontal" {
            pane split_direction="vertical" {
                pane name="􀀉 Mímir · IA full-stack" command="/Users/henriquepaixao/Foodbot/foodbot-ops/bin/agent" start_suspended=true {
                    args "mimir"
                }
                pane name="􀀊 Bifröst · integrações" command="/Users/henriquepaixao/Foodbot/foodbot-ops/bin/agent" start_suspended=true {
                    args "bifrost"
                }
                pane name="􀀍 Frigg · produto e design" command="/Users/henriquepaixao/Foodbot/foodbot-ops/bin/agent" start_suspended=true {
                    args "frigg"
                }
            }
            pane split_direction="vertical" {
                pane name="􀀋 Bragi · texto, marketing, PDFs" command="/Users/henriquepaixao/Foodbot/foodbot-ops/bin/agent" start_suspended=true {
                    args "bragi"
                }
                pane name="􀀌 Níðhöggr · código morto e refatoração" command="/Users/henriquepaixao/Foodbot/foodbot-ops/bin/agent" start_suspended=true {
                    args "nidhoggr"
                }
            }
        }
    }

    // TRIPULAÇÃO: the menu of all agents (Enter starts one, Ctrl-R resumes one) and the crew page with the real mood.
    tab name="TRIPULAÇÃO" {
        pane split_direction="vertical" {
            pane name="menu" command="bash" size="60%" borderless=true {
                args "/Users/henriquepaixao/Github/RuneChest/scripts/runechest-agents.sh"
            }
            pane name="humor (ENTER abre a página)" command="bash" size="40%" start_suspended=true {
                args "/Users/henriquepaixao/Github/RuneChest/scripts/runechest-crew.sh"
            }
        }
    }

    // AMBIENTE: the local backend and app (one environment = both). At most 2 environments on the Mac, for all
    // sessions together (/Foodbot/CLAUDE.md §5). Suspended: ENTER starts each one; Ctrl-C stops it.
    tab name="AMBIENTE" {
        pane split_direction="vertical" {
            pane name="backend · ./gradlew dev (8080)" command="./gradlew" cwd="/Users/henriquepaixao/Foodbot/foodbot-service" start_suspended=true {
                args "dev"
            }
            pane name="app · scripts/dev.sh (5400)" command="./scripts/dev.sh" cwd="/Users/henriquepaixao/Foodbot/foodbot-app" start_suspended=true
        }
    }
}
